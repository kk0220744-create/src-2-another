# BeastX environment configuration
# Keep real values out of GitHub.

# Telegram bot credentials
BOT_TOKEN=YOUR_BOT_TOKEN
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH

# Telegram user ID allowed to use /broadcast
ADMINS=YOUR_TELEGRAM_USER_ID

# MongoDB
DB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
DB_NAME=beastxsavecontentbot

# Login mode
# True = users can create sessions through /login
# False = use STRING_SESSION below

LOGIN_SYSTEM=True
STRING_SESSION=

# Optional
CHANNEL_ID=
WAITING_TIME=10
ERROR_MESSAGE=True
